<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 is built into Windows 10/11: the .exe runs without an extra runtime -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <AssemblyName>Processor Affinity Manager</AssemblyName>
    <RootNamespace>ProcessorAffinityManager</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Product>Processor Affinity Manager</Product>
    <AssemblyTitle>Processor Affinity Manager</AssemblyTitle>
    <Authors>ProfessorDevlin</Authors>
    <Company>ProfessorDevlin</Company>
    <Copyright>© 2026 ProfessorDevlin</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="tray-white.ico" LogicalName="tray-white.ico" />
  </ItemGroup>

</Project>
